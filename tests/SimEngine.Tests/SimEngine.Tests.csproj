<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Relax analyzer rules that conflict with standard xUnit conventions:
        CA1707    - test method names use Method_Condition_Result underscores
        CA1861    - inline [] expected values are idiomatic in tests
        CA1859    - concrete return types don't matter for test helpers
        CA2007    - ConfigureAwait not needed in xUnit tests
        xUnit1051 - we pass explicit CancellationTokens in cancellation tests
    -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA1859;CA2007;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SimEngine\SimEngine.csproj" />
    <ProjectReference Include="..\..\src\SimEngine.ConsoleHost\SimEngine.ConsoleHost.csproj" />
    <ProjectReference Include="..\..\src\SimEngine.Game\SimEngine.Game.csproj" />
    <ProjectReference Include="..\..\src\SimEngine.Rendering\SimEngine.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestAssets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- WorldCatalog resolves content from <output>/Worlds; the console-host
         integration tests drive the in-process silo, which loads from there. -->
    <Content Include="TestAssets\grid4.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\grid4.geojson</Link>
    </Content>
    <Content Include="TestAssets\germany_admin1.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\germany_admin1.geojson</Link>
    </Content>
    <Content Include="TestAssets\grid4.countries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\grid4.countries.json</Link>
    </Content>
    <Content Include="TestAssets\germany_admin1.countries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\germany_admin1.countries.json</Link>
    </Content>
  </ItemGroup>
</Project>
