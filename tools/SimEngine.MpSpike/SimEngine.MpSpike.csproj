<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SimEngine.MpSpike</RootNamespace>
    <AssemblyName>SimEngine.MpSpike</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Spike harness: Console.WriteLine reporting is the whole point. -->
    <NoWarn>$(NoWarn);CA1303;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="Microsoft.Orleans.Streaming" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimEngine\SimEngine.csproj" />
    <ProjectReference Include="..\..\src\SimEngine.Game\SimEngine.Game.csproj" />
    <ProjectReference Include="..\..\src\SimEngine.Contracts\SimEngine.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SimEngine.Server\SimEngine.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\custom-test\grid4.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\grid4.geojson</Link>
    </Content>
    <Content Include="..\..\data\germany-test\germany_admin1.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\germany_admin1.geojson</Link>
    </Content>
    <Content Include="..\..\data\europe-west\europe_west_admin1.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\europe_west_admin1.geojson</Link>
    </Content>
    <Content Include="..\..\data\full-world\states\world_admin1.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\world_admin1.geojson</Link>
    </Content>
    <Content Include="..\..\data\custom-test\grid4.countries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\grid4.countries.json</Link>
    </Content>
    <Content Include="..\..\data\germany-test\germany_admin1.countries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\germany_admin1.countries.json</Link>
    </Content>
    <Content Include="..\..\data\europe-west\europe_west_admin1.countries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\europe_west_admin1.countries.json</Link>
    </Content>
    <Content Include="..\..\data\full-world\countries\world_admin1.countries.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Worlds\world_admin1.countries.json</Link>
    </Content>
  </ItemGroup>

</Project>
